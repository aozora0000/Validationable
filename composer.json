{
    "name": "aozora0000/validationable",
    "version": "0.0.1",
    "autoload": {
        "psr-4": {
            "Validationable\\": "src/Validationable/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "aozora0000",
            "email": "aozora0000@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "flow-php/array-dot": "~0.17.1",
        "ext-exif": "*",
        "ext-fileinfo": "*",
        "intervention/image": "^3.11",
        "egulias/email-validator": "^4.0",
        "z4kn4fein/php-semver": "^3.0",
        "ext-libxml": "*",
        "ext-simplexml": "*",
        "doctrine/inflector": "^2.0",
        "ext-dom": "*",
        "giggsey/libphonenumber-for-php": "^9.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.1",
        "illuminate/container": "^12.16",
        "illuminate/support": "^12.16",
        "symfony/var-dumper": "^7.3",
        "illuminate/http": "^12.17",
        "phpstan/phpstan": "^2.1",
        "rector/rector": "^2.0",
        "phpmd/phpmd": "@stable"
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse src tests --level 10 --memory-limit 2G",
        "rector:dry": "rector --dry-run",
        "rector:run": "rector",
        "pre-install-cmd": "php download.php",
        "pre-update-cmd": "php download.php",
        "md": "phpmd src text codesize,unusedcode,naming"
    }
}
